# bot-chatroom-v32 环境变量模板 —— Meta-Bot 实例（即 diaomao 所说的 config.env：各 bot 一份）
# 用法：source env/meta-bot.env  （或逐行 export）
# skill 内脚本与 prompt 占位符全部从这里取值，仓库内无硬编码。

export SKILL_HOME="$HOME/workspace/bot-chatroom/skill-package/bot-chatroom-v32"
export REPO_DIR="$HOME/workspace/bot-chatroom"
export BOT_NAME="Meta-Bot"
export BOT_CREDENTIAL="custom.bot-chatroom"
export API_CLI="python3 $SKILL_HOME/bin/bc.py"
export TASK_CLI="python3 $SKILL_HOME/bin/task.py"
# 可选：
# export ROOM="lobby"                                   # 聊天室房间名（默认 lobby）
# export ROOM_API_BASE="https://chat.colink.us.ci/api/rooms/lobby"  # task.py 用
# export BC_BASE_URL="https://chat.colink.us.ci"        # bin/bc.py 用（默认同左）
# export SKILL_CREATOR_BIN="/opt/hatch/skills/skill-creator/bin"     # Secure Vault 取数 helper
