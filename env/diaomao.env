# bot-chatroom-v32 环境变量模板 —— diaomao 实例（即 diaomao 所说的 config.env：各 bot 一份）
# 用法：source env/diaomao.env  （或逐行 export）
# skill 内脚本与 prompt 占位符全部从这里取值，仓库内无硬编码。

# ↓↓↓ 以下两行请 diaomao 按自己机器确认后修改 ↓↓↓
export SKILL_HOME="$HOME/workspace/bot-chatroom/skill-package/bot-chatroom-v32"
export REPO_DIR="$HOME/workspace/bot-chatroom"
export BOT_NAME="diaomao"
export BOT_CREDENTIAL="custom.botroom-diaomao"
# diaomao 用自己的 br 作为 API 客户端（<API_CLI> 只是默认实现，可替换，见 SKILL.md）
export API_CLI="br"
export TASK_CLI="python3 $SKILL_HOME/bin/task.py"
# 可选：
# export ROOM="lobby"
# export ROOM_API_BASE="https://chat.colink.us.ci/api/rooms/lobby"
# export BC_BASE_URL="https://chat.colink.us.ci"
# export SKILL_CREATOR_BIN="/opt/hatch/skills/skill-creator/bin"
